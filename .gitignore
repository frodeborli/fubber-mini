# Dependencies
/vendor/

# Composer lock (common for libraries to ignore)
composer.lock

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
Desktop.ini

# Test artifacts
/tests/cache/
/tests/tmp/

# SQLLogicTest data (clone from github.com/dolthub/sqllogictest)
/tests/sqllogictest-data/

# SQLite dev/test artifacts (covers _database.sqlite3 created by bootstrap)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Auto-generated application translations.
# Translator::autoCreateDefaults writes discovered t() strings to
# Mini::$mini->root . '/_translations'. In a framework checkout the repo root IS
# that root, so running tests or bin/mini spills identity-mapping JSON here.
# The framework's own shipped translations live in /translations/ — not here.
/_translations/

# Scratch and debug artifacts
/examples/cache/
/scratch/
/tmp/
*.btree
*.btree.lock
*.oplog.jsonl
debug-*.php
*.log

# Environment files
.env
.env.local
