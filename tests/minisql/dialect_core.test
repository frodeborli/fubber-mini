# MiniSQL dialect conformance — core semantics
#
# THE SHARED SPEC. This file is the executable definition of MiniSQL, the SQL
# dialect implemented by BOTH the PHP engine (mini\Database\VirtualDatabase)
# and the Python port (minivdb). It is written in sqllogictest format, which
# is language-neutral by design, so the same file runs against both engines.
#
# A behaviour is MiniSQL if and only if it is pinned here. Where the dialect
# deliberately differs from SQLite, this file records the difference, so the
# divergence is a decision rather than an accident of an implementation.
#
# Add a case here BEFORE implementing a dialect decision in either engine.

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, n INTEGER, r REAL, s TEXT)

statement ok
INSERT INTO t VALUES(1, 10, 2.5, 'alpha')

statement ok
INSERT INTO t VALUES(2, 25, 7.25, 'beta')

statement ok
INSERT INTO t VALUES(3, NULL, NULL, NULL)

# --- Division: PHP semantics, deliberately NOT SQLite's -------------------
# int/int yields int when exact, float otherwise; division by zero is NULL.
# SQLite would answer 2 for 10/4 (integer division). This is the dialect's
# one deliberate arithmetic divergence and it is the same in both engines.

query I
SELECT 10 / 5
----
2

query R
SELECT 10 / 4
----
2.500

query T
SELECT CASE WHEN 1 / 0 IS NULL THEN 'null' ELSE 'not-null' END
----
null

# --- Comparison affinity: SQLite's two-stage rule --------------------------
# A bare column operand carries its column's affinity and converts the other
# side; an expression operand carries none. Both engines agree with SQLite.

query I
SELECT id FROM t WHERE n = '25'
----
2

query I
SELECT COUNT(*) FROM t WHERE n + 0 = '25'
----
0

query I
SELECT id FROM t WHERE s = 'alpha'
----
1

# --- Three-valued logic ----------------------------------------------------

query I
SELECT COUNT(*) FROM t WHERE n = NULL
----
0

query I
SELECT COUNT(*) FROM t WHERE n IS NULL
----
1

query I
SELECT COUNT(*) FROM t WHERE n != 10
----
1

query I
SELECT COUNT(*) FROM t WHERE NOT (n > 100)
----
2

# --- Aggregates over NULL --------------------------------------------------

query II
SELECT COUNT(*), COUNT(n) FROM t
----
3
2

query I
SELECT SUM(n) FROM t
----
35

query T
SELECT CASE WHEN SUM(n) IS NULL THEN 'null' ELSE 'value' END FROM t WHERE id > 100
----
null

# --- Ordering: NULLs sort first --------------------------------------------
# Unsorted comparison (no rowsort) so the ORDER BY itself is what is pinned:
# row 3 has n = NULL and must come first, as SQLite orders it.

query I
SELECT id FROM t ORDER BY n
----
3
1
2

# --- String functions: SQLite spellings are the supported ones -------------

query T
SELECT UPPER(s) FROM t WHERE id = 1
----
ALPHA

query I
SELECT LENGTH(s) FROM t WHERE id = 2
----
4

query T
SELECT SUBSTR(s, 1, 3) FROM t WHERE id = 1
----
alp

query T
SELECT s || '!' FROM t WHERE id = 1
----
alpha!

# --- Standard scalar syntax (Core SQL) also supported ----------------------

query I
SELECT CHARACTER_LENGTH(s) FROM t WHERE id = 2
----
4

query T
SELECT SUBSTRING(s FROM 1 FOR 3) FROM t WHERE id = 1
----
alp

query I
SELECT POSITION('ph' IN s) FROM t WHERE id = 1
----
3

query T
SELECT TRIM(BOTH 'a' FROM s) FROM t WHERE id = 1
----
lph

# --- CAST: SQLite coercion rules -------------------------------------------

query I
SELECT CAST('12abc' AS INTEGER)
----
12

query I
SELECT CAST('abc' AS INTEGER)
----
0

query I
SELECT CAST(1.7 AS INTEGER)
----
1

# --- LIKE with ESCAPE ------------------------------------------------------

query I
SELECT COUNT(*) FROM t WHERE s LIKE 'al%'
----
1

query I
SELECT COUNT(*) FROM t WHERE s LIKE 'a!%' ESCAPE '!'
----
0

# --- CTEs, including the recursive column-list form ------------------------

query I rowsort
WITH c AS (SELECT id FROM t WHERE id < 3) SELECT id FROM c
----
1
2

query I rowsort
WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x < 4) SELECT x FROM c
----
1
2
3
4

# --- Set quantifiers: DISTINCT and its explicit opposite, ALL ---------------
# ALL is the SQL:2003 default (keep duplicates), so it only has to be
# accepted — SELECT ALL x is exactly SELECT x. It appears constantly in the
# public sqllogictest corpus, which is where its absence was found.

query I
SELECT ALL n FROM t WHERE id = 1
----
10

query I rowsort
SELECT ALL id FROM t
----
1
2
3

query I
SELECT COUNT(ALL n) FROM t
----
2

query I rowsort
SELECT DISTINCT n FROM t WHERE n IS NOT NULL
----
10
25

# --- Duplicate column names collapse (shared limitation, pinned) -----------
# Rows are name-keyed (stdClass in PHP, dict in Python), so two result columns
# cannot share a name: the later one wins. SQLite returns both. This is a
# property of the row representation, identical in both engines, and it is
# pinned here so the two cannot drift apart on it. Alias duplicates explicitly
# when a query would otherwise produce them.

query II
SELECT 1 AS x, 2 AS x, 3 AS y
----
2
3

# --- Colliding output column names are rejected ----------------------------
# Rows are name-keyed, so `SELECT a.id, b.id` would silently drop one column:
# the caller asked for two DIFFERENT columns and the engine's un-qualifying of
# the output name collided them. That is a wrong answer, so it fails fast with
# a message naming the fix. Aliasing is the fix and works.
#
# (Distinct from `SELECT 1 AS x, 2 AS x` above, where the caller named both
# columns the same deliberately - SQLite tolerates that and so do we.)

statement ok
CREATE TABLE ja(id INTEGER, label TEXT)

statement ok
CREATE TABLE jb(id INTEGER, ja_id INTEGER)

statement ok
INSERT INTO ja VALUES(1, 'one')

statement ok
INSERT INTO jb VALUES(99, 1)

# Colliding qualified columns fall back to `qualifier_column`, so nothing is
# lost and the result is still reachable as $row->ja_id in PHP (a qualified
# key would not be: $row->ja.id is not valid PHP syntax).

query II
SELECT ja.id, jb.id FROM ja JOIN jb ON jb.ja_id = ja.id
----
1
99

# The same column selected twice is redundant, not lossy - one output column.

query I
SELECT ja.id, ja.id FROM ja JOIN jb ON jb.ja_id = ja.id
----
1

# When the fallback ITSELF would collide there is no safe answer left, so it
# fails fast rather than guessing: ja.id -> ja_id clashes with the real
# jb.ja_id -> ja_id.

statement error
SELECT ja.id, jb.id, jb.ja_id FROM ja JOIN jb ON jb.ja_id = ja.id

query II
SELECT ja.id AS a_key, jb.id AS b_key FROM ja JOIN jb ON jb.ja_id = ja.id
----
1
99

query IT
SELECT ja.id, ja.label FROM ja JOIN jb ON jb.ja_id = ja.id
----
1
one
