{
    "name": "fubber/mini",
    "description": "Forkable core PHP framework with zero dependencies beyond PSR interfaces: SQL-first database layer with a federated virtual SQL engine, PSR-15 routing, template inheritance, ICU i18n, RFC 5322 mail, JSON Schema validation — provides implementations for the PSR container, http-message, http-client, simple-cache and log contracts",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "core-framework",
        "zero-dependencies",
        "psr",
        "psr-7",
        "psr-15",
        "sql",
        "database",
        "routing",
        "templating",
        "i18n",
        "cache",
        "validation",
        "mail"
    ],
    "homepage": "https://github.com/frodeborli/fubber-mini",
    "support": {
        "issues": "https://github.com/frodeborli/fubber-mini/issues",
        "source": "https://github.com/frodeborli/fubber-mini"
    },
    "authors": [
        {
            "name": "Frode Borli",
            "email": "frode@borli.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "mini\\": "src/"
        },
        "files": [
            "bootstrap.php",
            "functions.php",
            "src/Cache/functions.php",
            "src/Converter/functions.php",
            "src/Database/functions.php",
            "src/Database/Virtual/functions.php",
            "src/Dispatcher/functions.php",
            "src/Router/functions.php",
            "src/Http/functions.php",
            "src/I18n/functions.php",
            "src/Static/functions.php",
            "src/Table/functions.php",
            "src/Template/functions.php",
            "src/Logger/functions.php",
            "src/Mail/functions.php",
            "src/Auth/functions.php",
            "src/CLI/functions.php",
            "src/UUID/functions.php",
            "src/Async/functions.php",
            "src/Validator/functions.php",
            "src/Metadata/functions.php",
            "src/Inference/functions.php",
            "src/Authorizer/functions.php",
            "src/Session/functions.php",
            "src/Dispatcher/defaults.php"
        ]
    },
    "bin": [
        "bin/mini",
        "bin/mini.bat",
        "bin/mini.cmd",
        "bin/mini.php"
    ],
    "extra": {
        "mini": {
            "commands": {
                "serve":        { "script": "bin/mini-serve.php",        "description": "Start development server" },
                "benchmark":    { "script": "bin/mini-benchmark.php",    "description": "Benchmark framework performance" },
                "translations": { "script": "bin/mini-translations.php", "description": "Manage translation files" },
                "migrations":   { "script": "bin/mini-migrations.php",   "description": "Run database migrations with tracking and rollback" },
                "docs":         { "script": "bin/mini-docs.php",         "description": "Browse PHP documentation" },
                "test":         { "script": "bin/mini-test.php",         "description": "Run tests" },
                "db":           { "script": "bin/mini-db.php",           "description": "Interactive database shell (use -v for VirtualDatabase)" },
                "aspects":      { "script": "bin/mini-aspects.php",      "description": "Sync aspect bundles with Composer" }
            }
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/polyfill-intl-icu": "^1.25",
        "symfony/polyfill-intl-messageformatter": "^1.25",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/log": "^3.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-client": "^1.0"
    },
    "provide": {
        "psr/simple-cache-implementation": "1.0|2.0|3.0",
        "psr/container-implementation": "1.1|2.0",
        "psr/http-message-implementation": "1.0|2.0",
        "psr/http-client-implementation": "1.0",
        "psr/log-implementation": "3.0"
    },
    "suggest": {
        "ext-intl": "For full internationalization features with all languages and locales (the bundled symfony polyfills cover the basics)",
        "ext-curl": "Required by the bundled PSR-18 HttpClient",
        "ext-pdo_sqlite": "For the default SQLite-backed cache and database features"
    }
}
